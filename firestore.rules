rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public tax updates: anyone using the app can read, only the backend writes.
    match /updates/{id} {
      allow read: if request.auth != null;
      allow write: if false;
      // Full PDF text is only for the backend's chat, not the app.
      match /content/{doc} {
        allow read, write: if false;
      }
    }
    // "Report this answer/summary": app users can file a report, never read them.
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['kind', 'targetId', 'question', 'answer', 'uid', 'createdAt'])
        && request.resource.data.kind in ['summary', 'answer']
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.answer == null || request.resource.data.answer.size() < 5000)
        && (request.resource.data.question == null || request.resource.data.question.size() < 600);
    }
    // Collector health, usage counters: backend only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
